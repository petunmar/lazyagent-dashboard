{
  "name": "lazyagent-dashboard",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first dashboard for monitoring and steering lazyagent/pi coding-agent sessions.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "web": "vite --host 127.0.0.1",
    "backend": "node src/backend/server.js",
    "build": "tsc --noEmit && vite build",
    "start": "node src/backend/server.js",
    "preview": "vite preview --host 127.0.0.1",
    "sessions": "node examples/list-sessions.js",
    "watch": "node examples/watch-sessions.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
