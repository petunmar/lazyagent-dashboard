{
  "name": "lazyagent-dashboard",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first dashboard for monitoring and steering lazyagent/pi coding-agent sessions.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "web": "vite --host 127.0.0.1",
    "backend": "node src/backend/server.js",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node src/backend/server.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "sessions": "node examples/list-sessions.js",
    "watch": "node examples/watch-sessions.js",
    "hash-password": "node scripts/hash-password.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.3.2"
  },
  "dependencies": {
    "vue": "^3.5.34"
  }
}
