# Copy to /etc/lazyagent-dashboard.env and chmod 600.
# Generate with: node scripts/hash-password.js 'a long unique password'
DASHBOARD_PASSWORD_HASH=scrypt$16384$8$1$replace_with_salt$replace_with_hash
# Generate with: openssl rand -base64 48
DASHBOARD_AUTH_SECRET=replace_with_random_secret
DASHBOARD_AUTH_SECURE_COOKIES=true
DASHBOARD_AUTH_SESSION_DAYS=30

EXTENSION_HOST=127.0.0.1
EXTENSION_PORT=5174
LAZYAGENT_URL=http://127.0.0.1:7421
PI_SESSIONS_DIR=/home/petur/.pi/agent/sessions
WIDGETS_DIR=/home/petur/coding/lazyagent-extension/widgets
NODE_ENV=production
