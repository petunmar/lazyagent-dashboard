# Copy to /etc/lazyagent-dashboard.env and chmod 600.
# Generate with: node scripts/hash-password.js 'a long unique password'
DASHBOARD_PASSWORD_HASH=scrypt$16384$8$1$replace_with_salt$replace_with_hash
# Generate with: openssl rand -base64 48
DASHBOARD_AUTH_SECRET=replace_with_random_secret
DASHBOARD_AUTH_SECURE_COOKIES=true
DASHBOARD_AUTH_SESSION_DAYS=30

EXTENSION_HOST=127.0.0.1
EXTENSION_PORT=5174
LAZYAGENT_URL=http://127.0.0.1:7421
# Optional but recommended: lets the authenticated dashboard proxy call lazyagent server-side,
# so browsers only need the dashboard password and can auto-connect to /lazyagent.
LAZYAGENT_API_PASSPHRASE=replace_with_the_same_value_from_lazyagent-api.env
PI_SESSIONS_DIR=/home/petur/.pi/agent/sessions
DASHBOARD_SYSTEM_PROMPT_FILE=/home/petur/.pi/lazyagent-extension/system-prompt.md
WIDGETS_DIR=/home/petur/coding/lazyagent-extension/widgets
# Optional: enables Question Queue Voice Mode. Voice resolves by name unless ELEVENLABS_VOICE_ID is set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NAME=Bradford
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
NODE_ENV=production
