[Unit]
Description=Lazyagent API for pi sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=petur
WorkingDirectory=/home/petur
Environment=PATH=/home/petur/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/lazyagent-api.env
ExecStart=/usr/bin/env lazyagent --api --agent pi --host 127.0.0.1:7421
Restart=always
RestartSec=10
# Keep the API stable while dashboard-launched agents run. If this service ever owns
# child agents, KillMode=process prevents restarts from killing their tool subprocesses.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
# Shared /tmp lets the dashboard render browser_screenshot files saved by pi-browser-harness.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
