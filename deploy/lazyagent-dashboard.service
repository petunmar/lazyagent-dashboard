[Unit]
Description=Lazyagent dashboard (secure public frontend + local backend)
After=network-online.target lazyagent-api.service
Wants=network-online.target lazyagent-api.service

[Service]
Type=simple
User=petur
WorkingDirectory=/home/petur/coding/lazyagent-extension
Environment=PATH=/home/petur/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/lazyagent-dashboard.env
ExecStartPre=/usr/bin/env npm run build
ExecStart=/usr/bin/env npm run start
Restart=always
RestartSec=10
# Do not set RuntimeMaxSec here: dashboard-launched agents can run for hours.
# Kill only the dashboard process on deploy/restart; pi agents and their tool subprocesses
# must survive so long-running installs/tests do not get stranded mid-tool-call.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# The dashboard launches pi in project directories, so it needs normal access to /home/petur.

[Install]
WantedBy=multi-user.target
